# Development-only settings loaded by `bun run dev` (root) and Vite (envDir = repo root).
# The token is fixed so the dashboard on :5173 can talk to the server on :4488 without ?t=.
LOCASTACK_SESSION_TOKEN=locastack-dev-session-token
LOCASTACK_EXTRA_HOSTS=127.0.0.1:5173,localhost:5173
VITE_LOCASTACK_TOKEN=locastack-dev-session-token
