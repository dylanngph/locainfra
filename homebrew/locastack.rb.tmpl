class Locastack < Formula
  desc "Local Docker dev services, managed from a dashboard"
  homepage "https://github.com/dylanngph/locastack"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/dylanngph/locastack/releases/download/v@VERSION@/locastack-@VERSION@-darwin-arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/dylanngph/locastack/releases/download/v@VERSION@/locastack-@VERSION@-darwin-x64.tar.gz"
      sha256 "@SHA_DARWIN_X64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/dylanngph/locastack/releases/download/v@VERSION@/locastack-@VERSION@-linux-arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/dylanngph/locastack/releases/download/v@VERSION@/locastack-@VERSION@-linux-x64.tar.gz"
      sha256 "@SHA_LINUX_X64@"
    end
  end

  def install
    bin.install "locastack"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/locastack --version")
  end
end
