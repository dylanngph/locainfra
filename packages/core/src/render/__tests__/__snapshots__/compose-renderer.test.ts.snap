        - "-d"
        - "shop"
      interval: "5s"
      retries: 10
    labels:
      locainfra.stack: "shop"
      locainfra.service: "main-db"
      locainfra.instance: "main-db"
      locainfra.type: "postgres"
      locainfra.catalog-id: "postgres"
      locainfra.version: "17"
    networks:
      - "li-shop"
  events:
    image: "postgres:17-alpine"
    container_name: "li-shop-events"
    restart: "unless-stopped"
    environment:
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "\${LI_SECRET_EVENTS__POSTGRES_PASSWORD}"
      POSTGRES_DB: "shop"
    ports:
      - "127.0.0.1:5434:5432"
    healthcheck:
      test:
        - "CMD"
        - "pg_isready"
        - "-U"
        - "postgres"
        - "-d"
        - "shop"
      interval: "5s"
      retries: 10
    labels:
      locainfra.stack: "shop"
      locainfra.service: "events"
      locainfra.instance: "events"
      locainfra.type: "postgres"
      locainfra.catalog-id: "postgres"
      locainfra.version: "17"
    networks:
      - "li-shop"
  cache:
    image: "redis:7-alpine"
    container_name: "li-shop-cache"
    restart: "unless-stopped"
    command:
      - "redis-server"
      - "--requirepass"
      - "\${LI_SECRET_CACHE__REDIS_PASSWORD}"
      - "--appendonly"
      - "yes"
    environment:
      REDISCLI_AUTH: "\${LI_SECRET_CACHE__REDIS_PASSWORD}"
    ports:
      - "127.0.0.1:6380:6379"
    volumes:
      - "li-shop-cache-data:/data"
    healthcheck:
      test:
        - "CMD"
        - "redis-cli"
        - "ping"
      interval: "5s"
      retries: 10
    labels:
      locainfra.stack: "shop"
      locainfra.service: "cache"
      locainfra.instance: "cache"
      locainfra.type: "redis"
      locainfra.catalog-id: "redis"
      locainfra.version: "7"
    networks:
      - "li-shop"
  rest:
    image: "hiett/serverless-redis-http:latest"
    container_name: "li-shop-rest"
    restart: "unless-stopped"
    environment:
      SRH_MODE: "env"
      SRH_TOKEN: "\${LI_SECRET_REST__SRH_TOKEN}"
      SRH_CONNECTION_STRING: "redis://:\${LI_SECRET_CACHE__REDIS_PASSWORD}@cache:6379"
    ports:
      - "127.0.0.1:8080:80"
    healthcheck:
      test:
        - "CMD"
        - "nc"
        - "-z"
        - "127.0.0.1"
        - "80"
      interval: "5s"
      retries: 10
      start_period: "5s"
    depends_on:
      cache:
        condition: "service_healthy"
    labels:
      locainfra.stack: "shop"
      locainfra.service: "rest"
      locainfra.instance: "rest"
      locainfra.type: "upstash-redis"
      locainfra.catalog-id: "upstash-redis"
      locainfra.version: "latest"
    networks:
      - "li-shop"
volumes:
  li-shop-main-db-data:
    name: "li-shop-main-db-data"
    labels:
      locainfra.stack: "shop"
      locainfra.service: "main-db"
      locainfra.instance: "main-db"
      locainfra.type: "postgres"
  li-shop-cache-data:
    name: "li-shop-cache-data"
    labels:
      locainfra.stack: "shop"
      locainfra.service: "cache"
      locainfra.instance: "cache"
      locainfra.type: "redis"
networks:
  li-shop:
    name: "li-shop"
    labels:
      locainfra.stack: "shop"
"
`;

