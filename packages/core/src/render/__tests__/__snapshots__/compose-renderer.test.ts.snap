  li-global-postgres-data:
    name: "li-global-postgres-data"
    labels:
      locainfra.stack: "global"
      locainfra.service: "postgres"
  li-global-redis-data:
    name: "li-global-redis-data"
    labels:
      locainfra.stack: "global"
      locainfra.service: "redis"
