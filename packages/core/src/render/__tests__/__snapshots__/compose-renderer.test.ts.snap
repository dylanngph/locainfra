      locainfra.catalog-id: "postgres"
      locainfra.version: "17"
    networks:
      - "li-shop"
  cache:
    image: "redis:7-alpine"
    container_name: "li-shop-cache"
    restart: "unless-stopped"
    command:
      - "redis-server"
      - "--requirepass"
