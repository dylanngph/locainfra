    container_name: "li-shop-main-db"
    restart: "unless-stopped"
    environment:
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "\${LI_SECRET_MAIN_DB__POSTGRES_PASSWORD}"
      POSTGRES_DB: "shop"
    ports:
      - "127.0.0.1:5433:5432"
    volumes:
      - "li-shop-main-db-data:/var/lib/postgresql/data"
    healthcheck:
      test:
        - "CMD"
        - "pg_isready"
        - "-U"
