      - "li-shop-cache-data:/data"
    healthcheck:
      test:
        - "CMD"
        - "redis-cli"
        - "ping"
      interval: "5s"
      retries: 10
    labels:
      locainfra.stack: "shop"
      locainfra.service: "cache"
      locainfra.instance: "cache"
      locainfra.type: "redis"
      locainfra.catalog-id: "redis"
      locainfra.version: "7"
    networks:
      - "li-shop"
volumes:
  li-shop-main-db-data:
    name: "li-shop-main-db-data"
    labels:
      locainfra.stack: "shop"
      locainfra.service: "main-db"
      locainfra.instance: "main-db"
      locainfra.type: "postgres"
  li-shop-cache-data:
