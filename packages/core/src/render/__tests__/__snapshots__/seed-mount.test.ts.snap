// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`seed file bind mount golden: read-only long-syntax bind after the data volume 1`] = `
"# Generated by LocaStack for stack "shop". Do not edit: changes are overwritten.
# Change the stack from the dashboard or its stack file instead.
name: "ls-shop"
services:
  main-db:
    image: "postgres:17-alpine"
    container_name: "ls-shop-main-db"
    restart: "unless-stopped"
    environment:
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "\${LI_SECRET_MAIN_DB__POSTGRES_PASSWORD}"
      POSTGRES_DB: "shop"
    ports:
      - "127.0.0.1:5433:5432"
    volumes:
      - "ls-shop-main-db-data:/var/lib/postgresql/data"
      - type: "bind"
        source: "/Users/dev/Developer/shop/db/seed.sql"
        target: "/docker-entrypoint-initdb.d/seed.sql"
        read_only: true
        bind:
          create_host_path: false
    healthcheck:
      test:
        - "CMD"
        - "pg_isready"
        - "-U"
        - "postgres"
        - "-d"
        - "shop"
      interval: "5s"
      retries: 10
    labels:
      locastack.stack: "shop"
      locastack.service: "main-db"
      locastack.instance: "main-db"
      locastack.type: "postgres"
      locastack.catalog-id: "postgres"
      locastack.version: "17"
    networks:
      - "ls-shop"
  events:
    image: "postgres:17-alpine"
    container_name: "ls-shop-events"
    restart: "unless-stopped"
    environment:
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "\${LI_SECRET_EVENTS__POSTGRES_PASSWORD}"
      POSTGRES_DB: "shop"
    ports:
      - "127.0.0.1:5434:5432"
    volumes:
      - type: "bind"
        source: "/Users/dev/Developer/shop/db/$$events.sql"
        target: "/docker-entrypoint-initdb.d/seed.sql"
        read_only: true
        bind:
          create_host_path: false
    healthcheck:
      test:
        - "CMD"
        - "pg_isready"
        - "-U"
        - "postgres"
        - "-d"
        - "shop"
      interval: "5s"
      retries: 10
    labels:
      locastack.stack: "shop"
      locastack.service: "events"
      locastack.instance: "events"
      locastack.type: "postgres"
      locastack.catalog-id: "postgres"
      locastack.version: "17"
    networks:
      - "ls-shop"
volumes:
  ls-shop-main-db-data:
    name: "ls-shop-main-db-data"
    labels:
      locastack.stack: "shop"
      locastack.service: "main-db"
      locastack.instance: "main-db"
      locastack.type: "postgres"
networks:
  ls-shop:
    name: "ls-shop"
    labels:
      locastack.stack: "shop"
"
`;
