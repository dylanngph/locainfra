{
	"name": "locastack",
	"version": "0.1.0",
	"description": "Dashboard-first local Docker dev services. Installs the prebuilt locastack binary for your platform.",
	"license": "MIT",
	"homepage": "https://github.com/dylanngph/locastack#readme",
	"bugs": "https://github.com/dylanngph/locastack/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dylanngph/locastack.git",
		"directory": "npm/locastack"
	},
	"keywords": [
		"docker",
		"local-development",
		"postgres",
		"redis",
		"dev-services",
		"dashboard"
