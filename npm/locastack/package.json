		"@locastack/cli-linux-x64": "0.1.0",
		"@locastack/cli-linux-arm64": "0.1.0",
		"@locastack/cli-linux-x64-musl": "0.1.0",
		"@locastack/cli-linux-arm64-musl": "0.1.0"
	}
}
